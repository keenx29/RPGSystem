@using RPGSystem.Models
@model RPGSystem.Models.CharacterSheetViewModel

<h1>@Model.Character.Name</h1>

<div class="d-flex flex-wrap">

    <partial name="_StatCard"
             model='new StatCardViewModel
             {
                 StatName = "Strength",
                 StatValue = Model.Character.Strength,
                 Modifier = Model.Character.GetStrengthModifier()
             }' />

    <partial name="_StatCard"
             model='new StatCardViewModel
             {
                 StatName = "Dexterity",
                 StatValue = Model.Character.Dexterity,
                 Modifier = Model.Character.GetDexterityModifier()
             }' />

    <partial name="_StatCard"
             model='new StatCardViewModel
             {
                 StatName = "Constitution",
                 StatValue = Model.Character.Constitution,
                 Modifier = Model.Character.GetConstitutionModifier()
             }' />

    <partial name="_StatCard"
             model='new StatCardViewModel
             {
                 StatName = "Intelligence",
                 StatValue = Model.Character.Intelligence,
                 Modifier = Model.Character.GetIntelligenceModifier()
             }' />

    <partial name="_StatCard"
             model='new StatCardViewModel
             {
                 StatName = "Wisdom",
                 StatValue = Model.Character.Wisdom,
                 Modifier = Model.Character.GetWisdomModifier()
             }' />

    <partial name="_StatCard"
             model='new StatCardViewModel
             {
                 StatName = "Charisma",
                 StatValue = Model.Character.Charisma,
                 Modifier = Model.Character.GetCharismaModifier()
             }' />

</div>

<div class="card mt-4 p-3">

    <h3>Roll History</h3>

    @if (Model.RollHistory.Any())
    {
        @foreach (var roll in Model.RollHistory)
        {
            <div class="border-bottom mb-2 pb-2">

                <strong>@roll.StatName</strong>

                rolled

                @if (roll.DiceRoll == 20)
                {
                    <strong class="text-success">
                        @roll.DiceRoll
                    </strong>
                }
                else if (roll.DiceRoll == 1)
                {
                    <strong class="text-danger">
                        @roll.DiceRoll
                    </strong>
                }
                else
                {
                    <strong>
                        @roll.DiceRoll
                    </strong>
                }

                @if (roll.Modifier >= 0)
                {
                    <span> + </span>
                }
                else
                {
                    <span> - </span>
                }

                <strong>@Math.Abs(roll.Modifier)</strong>

                =

                <strong>@roll.Total</strong>

            </div>
        }
    }
    else
    {
        <p>No rolls yet.</p>
    }

</div>