@using RPGSystem.Models
@using RPGSystem.Helpers
@model RPGSystem.Models.CharacterSheetViewModel

<h1>@Model.Character.Name</h1>

@* Stat Cards *@
<div class="d-flex flex-wrap">

    <partial name="_StatCard"
             model='new StatCardViewModel
             {
                 StatName = "Strength",
                 StatValue = Model.Character.Strength,
                 Modifier = Model.Character.GetStrengthModifier()
             }' />

    <partial name="_StatCard"
             model='new StatCardViewModel
             {
                 StatName = "Dexterity",
                 StatValue = Model.Character.Dexterity,
                 Modifier = Model.Character.GetDexterityModifier()
             }' />

    <partial name="_StatCard"
             model='new StatCardViewModel
             {
                 StatName = "Constitution",
                 StatValue = Model.Character.Constitution,
                 Modifier = Model.Character.GetConstitutionModifier()
             }' />

    <partial name="_StatCard"
             model='new StatCardViewModel
             {
                 StatName = "Intelligence",
                 StatValue = Model.Character.Intelligence,
                 Modifier = Model.Character.GetIntelligenceModifier()
             }' />

    <partial name="_StatCard"
             model='new StatCardViewModel
             {
                 StatName = "Wisdom",
                 StatValue = Model.Character.Wisdom,
                 Modifier = Model.Character.GetWisdomModifier()
             }' />

    <partial name="_StatCard"
             model='new StatCardViewModel
             {
                 StatName = "Charisma",
                 StatValue = Model.Character.Charisma,
                 Modifier = Model.Character.GetCharismaModifier()
             }' />

</div>

@* Derived Stats *@
<div class="card mt-4 p-3">

    <h3>Character Stats</h3>

    <div class="row">

        <div class="col-md-3">
            <strong>Level</strong>
            <p>@Model.Character.Level</p>
        </div>

        <div class="col-md-3">
            <strong>HP</strong>
            <p>
                @Model.Character.CurrentHP
                /
                @Model.Character.MaxHP
            </p>
        </div>

        <div class="col-md-3">
            <strong>Armor Class</strong>
            <p>@Model.Character.ArmorClass</p>
        </div>
    </div>
    <div class="row">

        <div class="col-md-3">
            <strong>Proficiency Bonus</strong>
            <p>@ModifierFormatter.Format(Model.Character.GetProficiencyBonus())</p>
        </div>

        <div class="col-md-3">
            <strong>Initiative</strong>
            <p>@ModifierFormatter.Format(Model.Character.GetInitiative())</p>
        </div>

        <div class="col-md-3">
            <strong>Passive Perception</strong>
            <p>@Model.Character.GetPassivePerception()</p>
        </div>

    </div>

</div>

@* Skills Panel *@
<div class="card mt-4 p-3">

    <h3>Skills</h3>

    @foreach (var skill in Model.Character.Skills)
    {
        int bonus = Model.Character.GetSkillBonus(skill);

        <div class="row align-items-center border-bottom p-2">

            <!-- LEFT: Skill info -->
            <div class="col">
                <strong>@skill.Name</strong>
                <span class="text-muted">
                    (@skill.RelatedAbility)
                </span>

                @if (skill.IsProficient)
                {
                    <span class="text-success ms-2">
                        Proficient
                    </span>
                }
            </div>

            <!-- MIDDLE: Bonus -->
            <div class="col-auto text-end">
                <span class="fw-bold">
                    @ModifierFormatter.Format(bonus)
                </span>
            </div>

            <!-- RIGHT: Button -->
            <div class="col-auto">
                <form asp-action="RollSkill" method="post" class="m-0">
                    <input type="hidden" name="skillName" value="@skill.Name" />

                    <button class="btn btn-sm btn-dark">
                        Roll
                    </button>
                </form>
            </div>

        </div>
    }

</div>

@* Roll History Panel *@
<div class="card mt-4 p-3">

    <h3>Roll History</h3>

    @if (Model.RollHistory.Any())
    {
        @foreach (var roll in Model.RollHistory)
        {
            <div class="border-bottom mb-2 pb-2">

                <strong>@roll.StatName</strong>

                rolled

                @if (roll.DiceRoll == 20)
                {
                    <strong class="text-success">
                        @roll.DiceRoll
                    </strong>
                }
                else if (roll.DiceRoll == 1)
                {
                    <strong class="text-danger">
                        @roll.DiceRoll
                    </strong>
                }
                else
                {
                    <strong>
                        @roll.DiceRoll
                    </strong>
                }
                <span>@ModifierFormatter.Format(roll.Modifier)</span>
                
                =

                <strong>@roll.Total</strong>
                
            </div>
        }
    }
    else
    {
        <p>No rolls yet.</p>
    }

</div>