@using RPGSystem.Helpers
@using RPGSystem.Models
@using RPGSystem.Models.Characters
@using RPGSystem.Models.Classes.Features
@using RPGSystem.Models.Rolls
@using RPGSystem.ViewModels
@using RPGSystem.Models.Items
@model RPGSystem.ViewModels.CharacterSheetViewModel

<div class="container-fluid">
    <div class="row">
        <div class="col-9 px-5 py-4">
            @* main content *@
            <div class="mb-2">
                <small class="text-muted">
                    Current roll mode: <strong>@Model.SelectedAdvantageState</strong>
                </small>
            </div>
            <form asp-action="SetAdvantageState" method="post">
                <div class="btn-group mb-3" role="group">

                    <button type="submit"
                            name="state"
                            value="Normal"
                            class="btn btn-secondary @(Model.SelectedAdvantageState == AdvantageState.Normal ? "active" : "")">
                        Normal
                    </button>

                    <button type="submit"
                            name="state"
                            value="Advantage"
                            class="btn btn-success @(Model.SelectedAdvantageState == AdvantageState.Advantage ? "active" : "")">
                        Advantage
                    </button>

                    <button type="submit"
                            name="state"
                            value="Disadvantage"
                            class="btn btn-danger @(Model.SelectedAdvantageState == AdvantageState.Disadvantage ? "active" : "")">
                        Disadvantage
                    </button>

                </div>
            </form>
            <div>
                <h1>@Model.Character.Name</h1>
            </div>
            @* Ability Cards *@
            <div class="d-flex flex-wrap">

                @foreach (var ability in Model.Character.Abilities)
                {
                    <partial name="_AbilityCard" model="ability" />
                }

            </div>
            @* Derived Stats *@
            <div class="card mt-4 p-3">

                <h3>Character Stats</h3>

                <div class="row">

                    <div class="col-md-4">
                        <strong>Level</strong>
                        <p>@Model.Character.Level</p>
                    </div>

                    <div class="col-md-4">
                        <strong>HP</strong>
                        <p>
                            @Model.Character.CurrentHP
                            /
                            @Model.Character.MaxHP
                        </p>
                    </div>

                    <div class="col-md-4">
                        <strong>Armor Class</strong>
                        <p>@Model.Character.GetArmorClass()</p>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4">
                        <strong>Proficiency Bonus</strong>
                        <p>@ModifierFormatter.FormatWithoutSpace(Model.Character.GetProficiencyBonus())</p>
                    </div>

                    <div class="col-md-4">
                        <strong>Initiative</strong>
                        <p>@ModifierFormatter.FormatWithoutSpace(Model.Character.GetInitiative())</p>
                    </div>

                    <div class="col-md-4">
                        <strong>Passive Perception</strong>
                        <p>@Model.Character.GetPassivePerception()</p>
                    </div>
                    <div class="col-md-4">
                        <strong>Hit Dice</strong>
                        <p>
                            @Model.Character.HitDiceRemaining / @(Model.Character.MaxHitDice)d@(Model.HitDie)
                        </p>
                    </div>
                </div>
            </div>
            @* Attack Panel *@
            <div class="row align-items-center">
                <div class="col">
                    <form asp-action="RollAttack" method="post">
                        <button class="btn btn-danger">
                            Attack Roll
                        </button>
                    </form>
                </div>
                <div class="col">
                    <form asp-action="RollDamage" method="post" class="mt-2">
                        <input type="hidden" name="weaponId" value="@Model.Character.EquippedWeapon.Id" />
                        <button class="btn btn-warning">
                            Damage Roll
                        </button>
                    </form>
                </div>
            </div>
            @* Skills Panel *@
            <div class="card mt-4 p-3">

                <h3>Skills</h3>

                @foreach (var skill in Model.Character.Skills)
                {
                    int bonus = Model.Character.GetSkillBonus(skill);

                    <div class="row align-items-center border-bottom p-2">

                        <div class="col">
                            <strong>@skill.Name</strong>
                            <span class="text-muted">
                                (@skill.RelatedAbility.Name)
                            </span>

                            @if (skill.IsExpertise)
                            {
                                <span class="text-success ms-2">
                                    Expertise
                                </span>
                            }
                            else if (skill.IsProficient)
                            {
                                <span class="text-success ms-2">
                                    Proficient
                                </span>
                            }
                        </div>

                        @if (skill.IsProficient)
                        {
                            <div class="col-auto text-end">
                                <span class="fw-bold">
                                    @ModifierFormatter.FormatWithoutSpace(bonus)
                                </span>
                            </div>
                        }
                        else
                        {
                            <div class="col-auto text-end">
                                <span class="">
                                    @ModifierFormatter.FormatWithoutSpace(bonus)
                                </span>
                            </div>
                        }


                        <div class="col-auto">
                            <form asp-action="RollSkill" method="post" class="m-0">
                                <input type="hidden" name="skillType" value="@skill.Type" />

                                <button class="btn btn-sm btn-dark">
                                    Roll
                                </button>
                            </form>
                        </div>

                    </div>
                }
            </div>
            @* Equipped Inventory Panel*@
            <div class="card p-3 mt-3">

                <h4 class="mb-3">Equipped</h4>

                <div class="equipped-container">

                    <!-- WEAPON SLOT -->
                    <div class="equipped-slot">

                        <div class="slot-label">
                            🗡 Weapon
                        </div>

                        <div class="slot-value">
                            @if (Model.Character.EquippedWeapon != null)
                            {
                                <span class="equipped-name">
                                    @Model.Character.EquippedWeapon.Name
                                </span>
                                <span class="text-muted">
                                    @Model.Character.EquippedWeapon.ScalingType
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">Empty</span>
                            }
                        </div>

                        <div class="slot-state @(Model.Character.EquippedWeapon != null ? "active" : "empty")">
                            @(Model.Character.EquippedWeapon != null ? "Equipped" : "Not equipped")
                        </div>

                    </div>
                    <!-- SHIELD SLOT -->
                    <div class="equipped-slot">
                        <div class="slot-label">
                            Shield
                        </div>

                        <div class="slot-value">
                            @if (Model.Character.EquippedShield != null)
                            {
                                <span class="equipped-name">
                                    @Model.Character.EquippedShield.Name
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">Empty</span>
                            }
                        </div>

                        <div class="slot-state @(Model.Character.EquippedShield != null ? "active" : "empty")">
                            @(Model.Character.EquippedShield != null ? "Equipped" : "Not equipped")
                        </div>
                    </div>
                    <!-- ARMOR SLOT -->
                    <div class="equipped-slot">

                        <div class="slot-label">
                            🛡 Armor
                        </div>

                        <div class="slot-value">
                            @if (Model.Character.EquippedArmor != null)
                            {
                                <span class="equipped-name">
                                    @Model.Character.EquippedArmor.Name
                                </span>
                                <span class="text-muted">
                                    @Model.Character.EquippedArmor.ArmorType
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">Unarmored</span>
                            }
                        </div>

                        <div class="slot-state @(Model.Character.EquippedArmor != null ? "active" : "empty")">
                            @(Model.Character.EquippedArmor != null ? "Equipped" : "Not equipped")
                        </div>

                    </div>

                </div>
            </div>
            @* Inventory Panel *@
            <div class="card p-3 mt-3">

                <h4 class="mb-3">Inventory</h4>

                @foreach (var item in Model.Character.Inventory)
                {
                    var isWeapon = item is Weapon;
                    var weapon = item as Weapon;
                    var isArmor = item is Armor;
                    var armor = item as Armor;
                    var isConsumable = item.Type == ItemType.Consumable;
                    
                    var isShield = armor?.ArmorType == ArmorType.Shield;

                    <div class="inventory-item @(Model.Character.EquippedWeapon?.Id == item.Id || Model.Character.EquippedArmor?.Id == item.Id ? "equipped" : "")">

                        <!-- HEADER -->
                        <div class="d-flex justify-content-between align-items-center">

                            <div class="d-flex align-items-center gap-2">

                                <strong>@item.Name</strong>

                                @if (isWeapon)
                                {
                                    <span class="badge bg-secondary">@(weapon.ScalingType) Weapon</span>
                                }
                                else if (isArmor)
                                {
                                    <span class="badge bg-secondary">@(armor.ArmorType) Armor</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@item.Type</span>
                                }

                            </div>

                            <!-- small weight / meta (future-proof feel) -->
                            <small class="text-muted">
                                @item.Weight lb
                            </small>

                        </div>

                        <!-- ACTIONS -->
                        <div class="mt-2 d-flex gap-2">

                            @if (isWeapon)
                            {
                                <form asp-action="EquipWeapon" method="post">
                                    <input type="hidden" name="weaponId" value="@item.Id" />

                                    <button class="btn btn-sm @(Model.Character.EquippedWeapon?.Id == item.Id ? "btn-success" : "btn-dark")">
                                        @(Model.Character.EquippedWeapon?.Id == item.Id ? "Equipped" : "Equip")
                                    </button>
                                </form>
                            }

                            @if (isShield)
                            {
                                <form asp-action="EquipShield" method="post">
                                    <input type="hidden" name="shieldId" value="@item.Id" />

                                    <button class="btn btn-sm @(Model.Character.EquippedShield?.Id == item.Id ? "btn-success" : "btn-dark")">
                                        @(Model.Character.EquippedShield?.Id == item.Id ? "Equipped" : "Equip")
                                    </button>
                                </form>
                            }else if (isArmor)
                            {
                                <form asp-action="EquipArmor" method="post">
                                    <input type="hidden" name="armorId" value="@item.Id" />

                                    <button class="btn btn-sm @(Model.Character.EquippedArmor?.Id == item.Id ? "btn-success" : "btn-dark")">
                                        @(Model.Character.EquippedArmor?.Id == item.Id ? "Equipped" : "Equip")
                                    </button>
                                </form>
                            }
                            @if (isConsumable)
                            {
                                <form asp-action="UseItem" method="post">
                                    <input type="hidden" name="itemId" value="@item.Id" />

                                    <button class="btn btn-sm btn-dark">
                                        Use
                                    </button>
                                </form>
                            }

                            @if (!isWeapon && !isArmor && !isConsumable)
                            {
                                <span class="text-muted small">No actions</span>
                            }

                        </div>

                    </div>
                }

            </div>
            @* HP Control Panel*@
            <div class="card p-3 mt-3 text-center">

                <h5>HP</h5>

                <h2>@Model.Character.CurrentHP / @Model.Character.MaxHP</h2>

                <form asp-action="ModifyHP" method="post">

                    <div class="d-flex justify-content-center align-items-center gap-2 mt-2">
                        <button class="btn btn-danger"
                                name="mode"
                                value="damage">
                            -
                        </button>

                        <input type="number"
                               name="amount"
                               value="1"
                               min="1"
                               class="form-control text-center"
                               style="width: 80px;" />

                        <button class="btn btn-success"
                                name="mode"
                                value="heal">
                            +
                        </button>

                    </div>

                </form>

            </div>
            @* Rest Panel*@
            
            <div class="row">
                <div class="col">
                    <form asp-action="ShortRest" method="post">
                        <div class="d-flex align-items-center gap-2">
                            <input type="number"
                                   name="hitDiceCount"
                                   value="0"
                                   min="0"
                                   max="@Model.Character.HitDiceRemaining"
                                   class="form-control text-center"
                                   style="width: 80px;" />

                            <button class="btn btn-warning">
                                Short Rest
                            </button>
                        </div>
                    </form>
                </div>
                <div class="col">
                    <form asp-action="LongRest" method="post">
                        <button class="btn btn-success">Long Rest</button>
                    </form>
                </div>
            </div>
            <div class="card p-3 text-center">

                <h5>Level</h5>

                <h2>@Model.Character.Level</h2>

                <form asp-action="LevelUp" method="post">

                    <button class="btn btn-warning btn-sm mt-2">
                        Level Up
                    </button>

                </form>

            </div>
            @* Class Features Panel *@
            <div class="card p-3">

                <h5>Class Features</h5>

                @foreach (var feature in Model.Character.ClassFeatures)
                {
                    <div class="d-flex justify-content-between align-items-center border p-2 mb-2">

                        <!-- LEFT -->
                        <div class="d-flex align-items-center gap-2">

                            @if (feature.IsAvailable || feature.IsActive || 
                            (feature.ResourceCost > 0 && Model.Character.FeatureResources.First(r => r.Name == feature.ResourceName).Current > 0))
                            {
                                <span class="text-success">✔</span>
                            }
                            else
                            {
                                <span class="text-danger">✖</span>
                            }

                            <strong>@feature.Name</strong>

                            @if (feature.MaxUses > 0)
                            {
                                <small class="text-muted">
                                    (@feature.UsesRemaining / @feature.MaxUses)
                                </small>
                            }else if ((feature.ResourceCost > 0 && Model.Character.FeatureResources.First(r => r.Name == feature.ResourceName).Current > 0))
                            {
                                <small class="text-muted">
                                    (@Model.Character.FeatureResources.First(r => r.Name == feature.ResourceName).Current / @Model.Character.FeatureResources.First(r => r.Name == feature.ResourceName).Max)
                                </small>
                            }

                            @if (feature.ActionType == FeatureActionType.Toggle)
                            {
                                <span class="badge @(feature.IsActive ? "bg-success" : "bg-secondary")">
                                    @(feature.IsActive ? "ON" : "OFF")
                                </span>
                            }

                        </div>

                        <!-- RIGHT -->
                        @switch (feature.ActionType)
                        {
                            case FeatureActionType.Use:
                                <form asp-action="UseFeature" method="post">
                                    <input type="hidden" name="featureName" value="@feature.Name" />
                                    <button class="btn btn-sm btn-warning"
                                            disabled="@(!feature.IsAvailable)">
                                        Use
                                    </button>
                                </form>
                                break;
                            case FeatureActionType.ResourceUse:
                                <form asp-action="UseFeature" method="post">
                                    <input type="hidden" name="featureName" value="@feature.Name" />
                                    <button class="btn btn-sm btn-warning"
                                            disabled="@(feature.ResourceCost > Model.Character.FeatureResources.First(r => r.Name == feature.ResourceName).Current)">
                                        Use
                                    </button>
                                </form>
                                break;

                            case FeatureActionType.Toggle:
                                <form asp-action="ToggleFeature" method="post">
                                    <input type="hidden" name="featureName" value="@feature.Name" />
                                    <button class="btn btn-sm btn-primary"
                                            disabled="@(feature.MaxUses > 0 && 
                                                        !feature.IsAvailable && 
                                                        !feature.IsActive)">
                                        Toggle
                                    </button>
                                </form>
                                break;
                        }

                    </div>
                }

            </div>
            @* Resource Panel *@
            <div class="card p-3 mt-3">

                <h5>Resources</h5>

                @foreach (var resource in Model.Character.FeatureResources)
                {
                    <div class="d-flex justify-content-between border p-2 mb-2">

                        <strong>@resource.Name</strong>

                        <span>
                            @resource.Current / @resource.Max
                        </span>

                    </div>
                }

            </div>
            @* Conditions Panel *@
            <div class="card mt-4 p-3">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="mb-0">Conditions</h3>

                    @if (Model.Character.Conditions.Any())
                    {
                        <form asp-action="ClearConditions" method="post" class="m-0">
                            <button class="btn btn-sm btn-outline-secondary">
                                Clear
                            </button>
                        </form>
                    }
                </div>

                @if (Model.Character.Conditions.Any())
                {
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        @foreach (var condition in Model.Character.Conditions)
                        {
                            <form asp-action="RemoveCondition" method="post" class="m-0">
                                <input type="hidden" name="condition" value="@condition" />

                                <button class="btn btn-sm btn-outline-danger">
                                    @condition ✕
                                </button>
                            </form>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted mb-3">No active conditions.</p>
                }

                <form asp-action="AddCondition" method="post">
                    <div class="d-flex gap-2">
                        <select name="condition" class="form-select">
                            @foreach (var condition in Enum.GetValues<ConditionType>())
                            {
                                if (!Model.Character.Conditions.Contains(condition))
                                {
                                    <option value="@condition">@condition</option>
                                }
                            }
                        </select>

                        <button class="btn btn-dark">
                            Add
                        </button>
                    </div>
                </form>

            </div>
        </div>

        <div class="col-3">
            <partial name="_RollHistoryPanel" model="Model.RollHistory" />
        </div>

    </div>
</div>










