@using RPGSystem.ViewModels
@model RPGSystem.ViewModels.CharacterSheetViewModel

<div class="sheet-page">

    <partial name="_RollModePanel" model="Model.SelectedAdvantageState" />

    <div class="sheet-header-grid">
        <partial name="_CharacterSummaryPanel"
                 model="new CharacterSummaryPanelViewModel
                 {
                     Character = Model.Character,
                     AvailableCharacters = Model.AvailableCharacters,
                     SelectedCharacterId = Model.SelectedCharacterId
                 }" />

        <partial name="_HitPointsPanel"
                 model="new HitPointsPanelViewModel
                 {
                     Character = Model.Character,
                     HitDie = Model.HitDie
                 }" />
    </div>

    <div class="sheet-body-grid">

        <main class="sheet-main-column">
            <partial name="_AbilitiesPanel" model="Model.Character" />
            <partial name="_SkillsPanel" model="Model.Character" />
            <partial name="_EquippedPanel" model="Model.Character" />
            <partial name="_InventoryPanel" model="Model.Character" />
            <partial name="_ClassFeaturesPanel" model="Model.Character" />
        </main>

        <aside class="sheet-side-column">
            <partial name="_StatsPanel" model="Model.Character" />
            <partial name="_ResourcesPanel" model="Model.Character" />
            <partial name="_ConditionsPanel" model="Model.Character" />
            <partial name="_RollHistoryPanel" model="Model.RollHistory" />
        </aside>

    </div>

</div>