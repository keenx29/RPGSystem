@using RPGSystem.Models.Classes
@model RPGSystem.ViewModels.CreateCharacterViewModel

@{
    ViewData["Title"] = "Create Character";
}

<div class="container py-4">

    <div class="mb-4">
        <h1>Create Character</h1>
        <p class="text-muted mb-0">
            Create a simple starting character from one of the supported class templates.
        </p>
    </div>

    <section class="card">
        <div class="card-body">
            <form asp-action="CreateCharacter" method="post">
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label">Character name</label>
                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Character name" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">Class</label>
                        <select asp-for="ClassType" class="form-select">
                            @foreach (var classType in Enum.GetValues<CharacterClassType>())
                            {
                                <option value="@classType">@classType</option>
                            }
                        </select>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">Race</label>
                        <input asp-for="Race"
                               class="form-control"
                               placeholder="Race" />
                        <span asp-validation-for="Race" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">Background</label>
                        <input asp-for="Background"
                               class="form-control"
                               placeholder="Background" />
                        <span asp-validation-for="Background" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-dark">
                        Create Character
                    </button>

                    <a asp-controller="Character"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </section>

</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}