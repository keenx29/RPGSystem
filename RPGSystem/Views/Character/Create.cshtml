@using RPGSystem.Models.Characters
@using RPGSystem.Models.Classes
@model RPGSystem.ViewModels.CreateCharacterViewModel

@{
    ViewData["Title"] = "Create Character";
}

<div class="container py-4">

    <div class="mb-4">
        <h1>Create Character</h1>
        <p class="text-muted mb-0">
            Create a simple starting character from one of the supported class templates.
        </p>
    </div>

    <section class="card">
        <div class="card-body">
            <form asp-action="CreateCharacter" method="post" enctype="multipart/form-data">
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label">Character name</label>
                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Character name" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">Class</label>
                        <select asp-for="ClassType" class="form-select">
                            @foreach (var classType in Enum.GetValues<CharacterClassType>())
                            {
                                <option value="@classType">@classType</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label asp-for="AbilityScoreMode" class="form-label">
                            Ability Scores
                        </label>

                        <select asp-for="AbilityScoreMode"
                                class="form-select"
                                id="ability-score-mode">
                            <option value="ClassTemplate">
                                Class template
                            </option>
                            <option value="StandardArray">
                                Standard array
                            </option>
                        </select>

                        <div class="form-text">
                            Standard array uses 15, 14, 13, 12, 10 and 8 once each.
                        </div>
                    </div>

                    <div class="col-12" id="standard-array-section">
                        <div class="row g-2">
                            @{
                                var abilityFields = new[]
                                {
                                    ("Strength", "StrengthScore"),
                                    ("Dexterity", "DexterityScore"),
                                    ("Constitution", "ConstitutionScore"),
                                    ("Intelligence", "IntelligenceScore"),
                                    ("Wisdom", "WisdomScore"),
                                    ("Charisma", "CharismaScore")
                                };
                            }

                            @foreach (var abilityField in abilityFields)
                            {
                                <div class="col-6 col-md-4">
                                    <label class="form-label">@abilityField.Item1</label>

                                    <select name="@abilityField.Item2" class="form-select">
                                        <option value="">Choose</option>

                                        @foreach (var score in CharacterCreationCatalog.StandardArray)
                                        {
                                            <option value="@score">@score</option>
                                        }
                                    </select>
                                </div>
                            }
                        </div>

                        <span asp-validation-for="AbilityScoreMode"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Race" class="form-label">Race</label>

                        <select asp-for="Race" class="form-select">
                            <option value="">Select a race</option>

                            @foreach (var race in CharacterCreationCatalog.Races)
                            {
                                <option value="@race">@race</option>
                            }
                        </select>

                        <span asp-validation-for="Race" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Background" class="form-label">Background</label>

                        <select asp-for="Background" class="form-select">
                            <option value="">Select a background</option>

                            @foreach (var background in CharacterCreationCatalog.Backgrounds)
                            {
                                <option value="@background">@background</option>
                            }
                        </select>

                        <span asp-validation-for="Background" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="PortraitFile" class="form-label">
                            Character portrait
                        </label>

                        <input asp-for="PortraitFile"
                               type="file"
                               class="form-control"
                               accept=".png,.jpg,.jpeg,.webp" />

                        <div class="form-text">
                            Optional. Default class portrait is used when no image is selected.
                        </div>

                        <span asp-validation-for="PortraitFile"
                              class="text-danger small"></span>
                    </div>

                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-dark">
                        Create Character
                    </button>

                    <a asp-controller="Character"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </section>

</div>
<script>
    const scoreMode = document.getElementById("ability-score-mode");
    const standardArraySection =
        document.getElementById("standard-array-section");

    function updateAbilityScoreMode() {
        const usesStandardArray =
            scoreMode.value === "StandardArray";

        standardArraySection.hidden = !usesStandardArray;
    }

    scoreMode.addEventListener("change", updateAbilityScoreMode);

    updateAbilityScoreMode();
</script>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}