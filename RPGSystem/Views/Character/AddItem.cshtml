@using RPGSystem.Models.Characters
@using RPGSystem.Models.Items
@model RPGSystem.ViewModels.AddInventoryItemViewModel

@{
    ViewData["Title"] = "Add Item";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h1>Add Item</h1>
            <p class="text-muted mb-0">
                Add a basic item, potion, weapon, or armor to the selected character inventory.
            </p>
        </div>

        <a asp-controller="Character"
           asp-action="Sheet"
           class="btn btn-outline-secondary">
            Back to Sheet
        </a>
    </div>

    <section class="card">
        <div class="card-body">

            <h3 class="sheet-subtitle">Add Item</h3>

            <form asp-action="AddInventoryItem" method="post" class="inventory-add-form">
                <label class="form-label small">Item kind</label>
                <select name="ItemKind"
                        id="inventoryItemKind"
                        class="form-select form-select-sm mb-3">
                    <option value="General">General Item</option>
                    <option value="HealingPotion">Healing Potion</option>
                    <option value="Weapon">Weapon</option>
                    <option value="Armor">Armor</option>
                </select>

                <input id="inventoryItemName"
                       name="Name"
                       class="form-control form-control-sm mb-2"
                       placeholder="Name" />
                <div class="mb-3">
                    <label asp-for="Weight" class="form-label">Weight (lb)</label>
                    <input id="inventoryItemWeight"
                           asp-for="Weight"
                           type="number"
                           step="0.1"
                           min="0"
                           class="form-control" />
                    <span asp-validation-for="Weight" class="text-danger"></span>
                </div>

                <div data-inventory-fields="healingpotion">
                    <label class="form-label small">Healing dice</label>
                    <input id="inventoryHealingDice"
                           name="HealingDice"
                           class="form-control form-control-sm mb-2"
                           value="2d4+2"
                           placeholder="e.g. 2d4+2 or 4d4+4" />
                </div>

                <label class="form-label small">Description</label>
                <textarea id="inventoryItemDescription"
                          name="Description"
                          class="form-control form-control-sm mb-2"
                          rows="3"
                          placeholder="What does this item do?"></textarea>

                <div id="stackableItemControl" class="form-check form-switch mb-2">
                    <input asp-for="IsStackable"
                           id="inventoryItemIsStackable"
                           class="form-check-input" />

                    <label asp-for="IsStackable" class="form-check-label">
                        Track quantity
                    </label>
                </div>

                <div id="stackableQuantityFields">
                    <label asp-for="Quantity" class="form-label small">Quantity</label>
                    <input asp-for="Quantity"
                           id="inventoryItemQuantity"
                           type="number"
                           min="1"
                           max="999"
                           class="form-control form-control-sm mb-2" />
                </div>

                <div data-inventory-fields="weapon">
                    <label class="form-label small">Weapon damage dice</label>
                    <input name="DamageDice"
                           class="form-control form-control-sm mb-2"
                           placeholder="e.g. 1d8 or 1d8+2" />

                    <label class="form-label small">Weapon damage type</label>
                    <select name="DamageType" class="form-select form-select-sm mb-2">
                        @foreach (var damageType in DefenseOptionCatalog.DamageTypes)
                        {
                            <option value="@damageType.ToLowerInvariant()">
                                @damageType
                            </option>
                        }
                    </select>

                    <label class="form-label small">Weapon scaling</label>
                    <select name="ScalingType" class="form-select form-select-sm mb-2">
                        @foreach (var scalingType in Enum.GetValues<WeaponScalingType>())
                        {
                            <option value="@scalingType">@scalingType</option>
                        }
                    </select>

                    <label class="form-label small">Weapon proficiency</label>
                    <select name="WeaponProficiencyType" class="form-select form-select-sm mb-2">
                        @foreach (var proficiencyType in Enum.GetValues<WeaponProficiencyType>())
                        {
                            <option value="@proficiencyType">@proficiencyType</option>
                        }
                    </select>

                    <div class="form-check form-switch mb-2">
                        <input asp-for="IsThrown"
                               id="inventoryWeaponIsThrown"
                               class="form-check-input" />

                        <label asp-for="IsThrown" class="form-check-label">
                            Thrown weapon
                        </label>
                    </div>

                    <div id="thrownWeaponRangeFields">
                        <label asp-for="NormalRangeFeet" class="form-label small">
                            Normal range (ft)
                        </label>
                        <input asp-for="NormalRangeFeet"
                               id="inventoryWeaponNormalRange"
                               type="number"
                               min="5"
                               step="5"
                               class="form-control form-control-sm mb-2"
                               placeholder="e.g. 20" />

                        <label asp-for="LongRangeFeet" class="form-label small">
                            Long range (ft)
                        </label>
                        <input asp-for="LongRangeFeet"
                               id="inventoryWeaponLongRange"
                               type="number"
                               min="5"
                               step="5"
                               class="form-control form-control-sm mb-2"
                               placeholder="e.g. 60" />
                    </div>

                    <label class="form-label small">Attack bonus</label>
                    <input name="AttackBonus"
                           type="number"
                           min="-5"
                           max="5"
                           value="0"
                           class="form-control form-control-sm mb-2" />
                </div>

                <div data-inventory-fields="armor">
                    <label class="form-label small">Armor type</label>
                    <select id="inventoryArmorType" name="ArmorType" class="form-select form-select-sm mb-2">
                        @foreach (var armorType in Enum.GetValues<ArmorType>())
                        {
                            <option value="@armorType">@armorType</option>
                        }
                    </select>

                    <label class="form-label small">Armor base AC / Shield bonus</label>
                    <input name="BaseArmorClass"
                           type="number"
                           min="1"
                           max="18"
                           class="form-control form-control-sm mb-2"
                           value="10" />
                </div>

                <button type="submit" class="btn btn-sm btn-dark">Add</button>
            </form>
        </div>
    </section>
</div>