@using RPGSystem.Models.Characters
@model RPGSystem.Models.Characters.Character
<div class="card mt-4 p-3">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">Conditions</h3>

        @if (Model.Conditions.Any())
        {
            <form asp-action="ClearConditions" method="post" class="m-0">
                <button class="btn btn-sm btn-outline-secondary">
                    Clear
                </button>
            </form>
        }
    </div>

    @if (Model.Conditions.Any())
    {
        <div class="d-flex flex-wrap gap-2 mb-3">
            @foreach (var condition in Model.Conditions)
            {
                <form asp-action="RemoveCondition" method="post" class="m-0">
                    <input type="hidden" name="condition" value="@condition" />

                    <button class="btn btn-sm btn-outline-danger">
                        @condition ✕
                    </button>
                </form>
            }
        </div>
    }
    else
    {
        <p class="text-muted mb-3">No active conditions.</p>
    }

    <form asp-action="AddCondition" method="post">
        <div class="d-flex gap-2">
            <select name="condition" class="form-select">
                @foreach (var condition in Enum.GetValues<ConditionType>())
                {
                    if (!Model.Conditions.Contains(condition))
                    {
                        <option value="@condition">@condition</option>
                    }
                }
            </select>

            <button class="btn btn-dark">
                Add
            </button>
        </div>
    </form>

</div>