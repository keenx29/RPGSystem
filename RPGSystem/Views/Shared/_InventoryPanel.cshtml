@using RPGSystem.Models.Items
@using RPGSystem.Helpers
@inject RPGSystem.Services.DiceService DiceService
@model RPGSystem.Models.Characters.Character
<section class="sheet-panel inventory-panel">
    <div class="panel-title-row">
        <h2 class="sheet-panel-title mb-0">Inventory</h2>

        <a asp-controller="Character"
           asp-action="AddItem"
           class="btn btn-sm btn-dark panel-add-button"
           title="Add item">
            +
        </a>
    </div>

    <div class="inventory-weight-summary
     @(Model.IsOverCarryingCapacity ? "over-capacity" : "")">
        <span>
            Weight:
            <strong>@Model.TotalCarriedWeight.ToString("0.##") lb</strong>
        </span>

        <span>
            Capacity:
            <strong>@Model.CarryingCapacity.ToString("0.##") lb</strong>
        </span>

        @if (Model.IsOverCarryingCapacity)
        {
            <span class="inventory-warning">
                Over carrying capacity
            </span>
        }
    </div>

    <form asp-controller="Character"
          asp-action="UpdateCurrency"
          method="post"
          class="currency-tracker"
          data-currency-form>

        <div class="currency-field currency-copper">
            <label for="copperPieces">Copper</label>
            <input id="copperPieces"
                   name="CopperPieces"
                   type="number"
                   min="0"
                   step="1"
                   inputmode="numeric"
                   value="@Model.CopperPieces"
                   data-currency-input />
        </div>

        <div class="currency-field currency-silver">
            <label for="silverPieces">Silver</label>
            <input id="silverPieces"
                   name="SilverPieces"
                   type="number"
                   min="0"
                   step="1"
                   inputmode="numeric"
                   value="@Model.SilverPieces"
                   data-currency-input />
        </div>

        <div class="currency-field currency-electrum">
            <label for="electrumPieces">Electrum</label>
            <input id="electrumPieces"
                   name="ElectrumPieces"
                   type="number"
                   min="0"
                   step="1"
                   inputmode="numeric"
                   value="@Model.ElectrumPieces"
                   data-currency-input />
        </div>

        <div class="currency-field currency-gold">
            <label for="goldPieces">Gold</label>
            <input id="goldPieces"
                   name="GoldPieces"
                   type="number"
                   min="0"
                   step="1"
                   inputmode="numeric"
                   value="@Model.GoldPieces"
                   data-currency-input />
        </div>

        <div class="currency-field currency-platinum">
            <label for="platinumPieces">Platinum</label>
            <input id="platinumPieces"
                   name="PlatinumPieces"
                   type="number"
                   min="0"
                   step="1"
                   inputmode="numeric"
                   value="@Model.PlatinumPieces"
                   data-currency-input />
        </div>
    </form>

    
    @foreach (var item in Model.Inventory)
    {
        var isWeapon = item is Weapon;
        var weapon = item as Weapon;
        var isArmor = item is Armor;
        var armor = item as Armor;

        var isShield = armor?.ArmorType == ArmorType.Shield;

        var isWeaponProficient =
        weapon != null &&
        Model.IsProficientWithWeapon(weapon);

        var isArmorProficient =
        armor != null &&
        (armor.ArmorType == ArmorType.Shield
        ? Model.IsProficientWithShield()
        : Model.IsProficientWithArmor(armor));

        var armorFormula = armor?.ArmorType switch
        {
            ArmorType.Light =>
            $"Base AC {armor.BaseArmorClass} + Dexterity modifier",

            ArmorType.Medium =>
            $"Base AC {armor.BaseArmorClass} + Dexterity modifier (max +2)",

            ArmorType.Heavy =>
            $"Base AC {armor.BaseArmorClass}",

            ArmorType.Shield =>
            $"+{armor.BaseArmorClass} AC while equipped",

            _ => ""
        };
        var weaponDetails = "";

        if (weapon != null)
        {
            var attackBonus = Model.GetAttackBonus(weapon);
            var damageBonus = Model.GetDamageBonus(weapon);
            var damageAbility = Model.GetAttackAbility(weapon);

            var damageType = string.IsNullOrWhiteSpace(weapon.DamageType)
            ? "Damage"
            : char.ToUpperInvariant(weapon.DamageType[0]) +
            weapon.DamageType[1..].ToLowerInvariant();

            var damageDice =
            DiceService.GetBaseDiceNotation(weapon.DamageDice);

            var weaponDamageBonus =
            DiceService.GetDiceModifier(weapon.DamageDice);

            var damageParts = new List<string>
            {
            $"{damageType} Damage {damageDice}"
            };

            if (weaponDamageBonus != 0)
            {
                damageParts.Add(
                $"{ModifierFormatter.FormatWithSpace(weaponDamageBonus)} Weapon Bonus");
            }

            if (damageBonus != 0)
            {
                damageParts.Add(
                $"{ModifierFormatter.FormatWithSpace(damageBonus)} {damageAbility.Name}");
            }

            weaponDetails =
            $"Attack {ModifierFormatter.FormatWithoutSpace(attackBonus)} · " +
            string.Join(" ", damageParts);
        }

        <div class="inventory-item @(Model.EquippedWeapon?.Id == item.Id || Model.EquippedArmor?.Id == item.Id ? "equipped" : "")">

            <!-- HEADER -->
            <div class="d-flex justify-content-between align-items-start gap-2">

                <div class="equipment-name-line">

                    <strong>@item.Name</strong>

                    @if (isWeapon)
                    {
                        <div class="equipment-tags">
                            <span class="equipment-tag @(isWeaponProficient ? "is-proficient" : "is-not-proficient")">
                                @(isWeaponProficient ? "Proficient" : "Not proficient")
                            </span>

                            <span class="equipment-tag">@weapon!.ScalingType</span>
                        </div>
                    }
                    else if (isArmor)
                    {
                        <div class="equipment-tags">
                            <span class="equipment-tag @(isArmorProficient ? "is-proficient" : "is-not-proficient")">
                                @(isArmorProficient ? "Proficient" : "Not proficient")
                            </span>

                            <span class="equipment-tag">
                                @(armor!.ArmorType == ArmorType.Shield
                                                        ? "Shield"
                                                        : $"{armor.ArmorType} Armor")
                            </span>
                        </div>
                    }
                    else
                    {
                        <span class="equipment-tag">@item.Type</span>
                    }
                    
                </div>
               
                <!-- small weight / meta (future-proof feel) -->
                <small class="text-muted">
                    @item.Weight lb
                </small>

            </div>
            @if (!string.IsNullOrWhiteSpace(item.Description))
            {
                <div class="inventory-description">
                    @item.Description
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(armorFormula))
            {
                <div class="inventory-armor-formula">
                    @armorFormula
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(weaponDetails))
            {
                <div class="equipment-details">
                    @weaponDetails
                </div>
            }
            <!-- ACTIONS -->
            <div class="mt-2 d-flex gap-2">

                @if (isWeapon)
                {
                    <form asp-action="EquipWeapon" method="post">
                        <input type="hidden" name="weaponId" value="@item.Id" />

                        <button class="btn btn-sm @(Model.EquippedWeapon?.Id == item.Id ? "btn-success" : "btn-dark")">
                            @(Model.EquippedWeapon?.Id == item.Id ? "Equipped" : "Equip")
                        </button>
                    </form>
                }

                @if (isShield)
                {
                    <form asp-action="EquipShield" method="post">
                        <input type="hidden" name="shieldId" value="@item.Id" />

                        <button class="btn btn-sm @(Model.EquippedShield?.Id == item.Id ? "btn-success" : "btn-dark")">
                            @(Model.EquippedShield?.Id == item.Id ? "Equipped" : "Equip")
                        </button>
                    </form>
                }
                else if (isArmor)
                {
                    <form asp-action="EquipArmor" method="post">
                        <input type="hidden" name="armorId" value="@item.Id" />

                        <button class="btn btn-sm @(Model.EquippedArmor?.Id == item.Id ? "btn-success" : "btn-dark")">
                            @(Model.EquippedArmor?.Id == item.Id ? "Equipped" : "Equip")
                        </button>
                    </form>
                }

                @if (!isWeapon && !isArmor)
                {
                    @if (item.Effect != null)
                    {
                        <form asp-action="UseItem" method="post" class="d-inline">
                            <input type="hidden" name="itemId" value="@item.Id" />
                            <button type="submit" class="btn btn-sm btn-dark">Use</button>
                        </form>
                    }
                    else
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled>
                            No Use
                        </button>
                    }
                }
                <form asp-action="RemoveInventoryItem" method="post" class="d-inline">
                    <input type="hidden" name="itemId" value="@item.Id" />
                    <button type="submit" class="btn btn-sm btn-outline-danger">
                        Remove
                    </button>
                </form>
            </div>

        </div>
    }

</section>
