@using RPGSystem.Helpers
@using RPGSystem.Models.Rolls
@model List<RPGSystem.Models.Rolls.RollResult>

<div class="roll-chat">
    <div class="roll-chat-header">
        <h5>Roll Chat</h5>
    </div>

    @if (!Model.Any())
    {
        <div class="text-muted small p-3">
            No rolls yet.
        </div>
    }

    @foreach (var roll in Model)
    {
        var advantageClass = roll.AdvantageType switch
        {
            AdvantageState.Advantage => "roll-chip-advantage",
            AdvantageState.Disadvantage => "roll-chip-disadvantage",
            _ => ""
        };

        var damageType = roll.DamageType?.Trim();
        var damageLabel = string.IsNullOrWhiteSpace(damageType)
        ? ""
        : $"{char.ToUpper(damageType[0])}{damageType[1..].ToLower()} Damage";
        var damageClass = (damageType ?? "").ToLowerInvariant() switch
        {
            "slashing" => "damage-slashing",
            "piercing" => "damage-piercing",
            "bludgeoning" => "damage-bludgeoning",
            "fire" => "damage-fire",
            "cold" => "damage-cold",
            "poison" => "damage-poison",
            "necrotic" => "damage-necrotic",
            "radiant" => "damage-radiant",
            "lightning" => "damage-lightning",
            "thunder" => "damage-thunder",
            "acid" => "damage-acid",
            "psychic" => "damage-psychic",
            "force" => "damage-force",
            _ => "damage-generic"
        };
        <div class="roll-message roll-@roll.Type.ToString().ToLower()">

            <div class="roll-message-header">
                <div class="roll-message-title">
                    <strong>@roll.Actor</strong>
                    <span class="roll-type-chip">@roll.Type</span>
                </div>

                <div class="roll-message-tags">
                    @if (roll.AdvantageType != AdvantageState.Normal)
                    {
                        <span class="roll-state-chip @advantageClass">
                            @roll.AdvantageType
                        </span>
                    }

                    @if (!string.IsNullOrWhiteSpace(damageType))
                    {
                        <span class="damage-chip @damageClass">
                            @damageLabel
                        </span>
                    }
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(roll.Description))
            {
                <div class="roll-description">
                    @roll.Description
                </div>
            }

            @if (roll.Type != RollType.Feature)
            {
                <div class="roll-total">
                    @roll.Total
                </div>

                <div class="roll-breakdown">
                    @roll.DiceRoll @ModifierFormatter.FormatWithSpace(roll.Modifier)
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(roll.Formula))
            {
                <div class="roll-formula">
                    @roll.Formula
                </div>
            }


            @if (roll.AppliedEffects.Any())
            {
                <div class="roll-effects">
                    @foreach (var effect in roll.AppliedEffects)
                    {
                        <span class="roll-effect">@effect</span>
                    }
                </div>
            }
            @if (roll.Explanations.Any())
            {
                <details class="roll-explanations">
                    <summary>Details</summary>

                    <ul class="mb-0 mt-2">
                        @foreach (var explanation in roll.Explanations)
                        {
                            <li class="@(explanation.Type == RollExplanationType.Ignored ? "text-muted" : "")">
                                <strong>@explanation.Source:</strong>
                                @explanation.Text

                                @if (explanation.Value.HasValue)
                                {
                                    <span>(@ModifierFormatter.FormatWithoutSpace(explanation.Value.Value))</span>
                                }

                                @if (!string.IsNullOrWhiteSpace(explanation.Dice))
                                {
                                    <span>(@explanation.Dice)</span>
                                }
                            </li>
                        }
                    </ul>
                </details>
            }

            <div class="roll-actions">
                @if (roll.CanRollDamage && roll.SourceItemId.HasValue)
                {
                    <form asp-controller="Character"
                          asp-action="RollDamage"
                          method="post"
                          class="mt-2">
                        <input type="hidden" name="weaponId" value="@roll.SourceItemId" />
                        <button class="btn btn-sm btn-warning">
                            Damage
                        </button>
                    </form>
                }
                @if (roll.CanRollCriticalDamage && roll.SourceItemId.HasValue)
                {
                    <form asp-controller="Character"
                          asp-action="RollCriticalDamage"
                          method="post"
                          class="mt-2">
                        <input type="hidden" name="weaponId" value="@roll.SourceItemId" />
                        <button class="btn btn-sm btn-warning">
                            Crit Damage
                        </button>
                    </form>
                }
            </div>
            @if (roll.IsCriticalSuccess)
            {
                <span class="badge bg-success">Critical Hit</span>
            }

            @if (roll.IsCriticalFailure)
            {
                <span class="badge bg-danger">Critical Fail</span>
            }
            @if (roll.IsCriticalDamage)
            {
                <span class="badge bg-warning text-dark">Critical Damage</span>
            }

        </div>
    }
</div>