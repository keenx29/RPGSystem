@model RPGSystem.ViewModels.CharacterSummaryPanelViewModel

<section class="sheet-panel character-summary-panel">

    <div class="d-flex justify-content-between align-items-start gap-3">

        <div>
            <h1 class="sheet-character-name">
                @Model.Character.Name
            </h1>

            <div class="text-muted">
                Level @Model.Character.Level @Model.Character.ClassType
            </div>

            <div class="text-muted">
                Proficiency Bonus:
                <strong>@RPGSystem.Helpers.ModifierFormatter.FormatWithoutSpace(Model.Character.GetProficiencyBonus())</strong>
            </div>
        </div>

        <form asp-controller="Character"
              asp-action="SelectCharacter"
              method="post"
              class="character-selector-form">
            <select name="characterId"
                    class="form-select form-select-sm"
                    onchange="this.form.submit()">
                @foreach (var character in Model.AvailableCharacters)
                {
                    <option value="@character.Id"
                            selected="@(character.Id == Model.SelectedCharacterId)">
                        @character.Name - Lvl @character.Level @character.ClassType
                    </option>
                }
            </select>
        </form>

    </div>

    <form asp-controller="Character" asp-action="LevelUp" method="post" class="mt-3">
        <button class="btn btn-sm btn-outline-warning">
            Level Up
        </button>
    </form>
    <form asp-action="SaveCharacters" method="post" class="m-0">
        <button type="submit" class="btn btn-sm btn-outline-dark">
            Save
        </button>
    </form>
</section>