@model RPGSystem.ViewModels.CharacterSummaryPanelViewModel

<section class="sheet-panel character-summary-panel">

    <div class="d-flex justify-content-between align-items-start gap-3">

        <div>
            <h1 class="sheet-character-name">
                @Model.Character.Name
            </h1>

            <div class="text-muted">
                Level @Model.Character.Level @Model.Character.ClassType
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Character.Race) ||
                        !string.IsNullOrWhiteSpace(Model.Character.Background))
            {
                <div class="text-muted">
                    @Model.Character.Race @Model.Character.Background
                </div>
            }
            <div class="text-muted">
                Proficiency Bonus:
                <strong>@RPGSystem.Helpers.ModifierFormatter.FormatWithoutSpace(Model.Character.GetProficiencyBonus())</strong>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 mt-3 flex-wrap">
        <form asp-controller="Character" asp-action="LevelUp" method="post" class="m-0">
            <button class="btn btn-sm btn-outline-warning">
                Level Up
            </button>
        </form>

        <form asp-action="SaveCharacters" method="post" class="m-0">
            <button type="submit" class="btn btn-sm btn-outline-dark">
                Save
            </button>
        </form>
    </div>
</section>