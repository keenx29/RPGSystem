@using RPGSystem.Models.Characters
@using RPGSystem.Models.Classes.Features
@model RPGSystem.Models.Characters.Character

<section class="sheet-panel">
    <div class="panel-title-row">
        <h2 class="sheet-panel-title">Defenses</h2>

        <details class="inline-editor">
            <summary class="panel-add-button" title="Add defense">+</summary>

            <form asp-controller="Character"
                  asp-action="AddDefense"
                  method="post"
                  class="inline-editor-form">
                <select name="Type" class="form-select form-select-sm">
                    <option value="@DefenseType.Resistance">Resistance</option>
                    <option value="@DefenseType.Vulnerability">Vulnerability</option>
                    <option value="@DefenseType.DamageImmunity">Damage Immunity</option>
                    <option value="@DefenseType.ConditionImmunity">Condition Immunity</option>
                </select>

                <input name="Name" class="form-control form-control-sm"
                       placeholder="For example: Fire" maxlength="50" required />

                <button class="btn btn-sm btn-primary" type="submit">Add</button>
            </form>
        </details>
    </div>

    <div class="defense-group">
        <div class="sheet-subtitle">Resistances</div>

        <div class="defense-list">
            @if (Model.DamageResistances.Any())
            {
                foreach (var defense in Model.DamageResistances)
                {
                    <span class="defense-chip">
                        @defense

                        <form asp-controller="Character"
                              asp-action="RemoveDefense"
                              method="post">
                            <input type="hidden" name="type"
                                   value="@DefenseType.Resistance" />
                            <input type="hidden" name="name" value="@defense" />
                            <button type="submit"
                                    class="compact-remove-button"
                                    title="Remove @defense"
                                    aria-label="Remove @defense">
                                ×
                            </button>
                        </form>
                    </span>
                }
            }
            else
            {
                <span class="text-muted small">None</span>
            }
        </div>
    </div>

    @if (Model.GetFeature(BarbarianFeatures.Rage)?.IsActive == true)
    {
        <div class="defense-group">
            <div class="sheet-subtitle">Temporary</div>
            <div>Rage: resistance to bludgeoning, piercing, and slashing damage</div>
        </div>
    }

    <div class="defense-group">
        <div class="sheet-subtitle">Vulnerabilities</div>

        <div class="defense-list">
            @if (Model.DamageVulnerabilities.Any())
            {
                foreach (var defense in Model.DamageVulnerabilities)
                {
                    <span class="defense-chip">
                        @defense

                        <form asp-controller="Character"
                              asp-action="RemoveDefense"
                              method="post">
                            <input type="hidden" name="type"
                                   value="@DefenseType.Vulnerability" />
                            <input type="hidden" name="name" value="@defense" />
                            <button type="submit"
                                    class="compact-remove-button"
                                    title="Remove @defense"
                                    aria-label="Remove @defense">
                                ×
                            </button>
                        </form>
                    </span>
                }
            }
            else
            {
                <span class="text-muted small">None</span>
            }
        </div>
    </div>

    <div class="defense-group">
        <div class="sheet-subtitle">Immunities</div>

        <div class="defense-list">
            @if (Model.DamageImmunities.Any())
            {
                foreach (var defense in Model.DamageImmunities)
                {
                    <span class="defense-chip">
                        @defense

                        <form asp-controller="Character"
                              asp-action="RemoveDefense"
                              method="post">
                            <input type="hidden" name="type"
                                   value="@DefenseType.DamageImmunity" />
                            <input type="hidden" name="name" value="@defense" />
                            <button type="submit"
                                    class="compact-remove-button"
                                    title="Remove @defense"
                                    aria-label="Remove @defense">
                                ×
                            </button>
                        </form>
                    </span>
                }
            }
            else
            {
                <span class="text-muted small">None</span>
            }
        </div>
    </div>

    <div class="defense-group">
        <div class="sheet-subtitle">Condition Immunities</div>

        <div class="defense-list">
            @if (Model.ConditionImmunities.Any())
            {
                foreach (var defense in Model.ConditionImmunities)
                {
                    <span class="defense-chip">
                        @defense

                        <form asp-controller="Character"
                              asp-action="RemoveDefense"
                              method="post">
                            <input type="hidden" name="type"
                                   value="@DefenseType.ConditionImmunity" />
                            <input type="hidden" name="name" value="@defense" />
                            <button type="submit"
                                    class="compact-remove-button"
                                    title="Remove @defense"
                                    aria-label="Remove @defense">
                                ×
                            </button>
                        </form>
                    </span>
                }
            }
            else
            {
                <span class="text-muted small">None</span>
            }
        </div>
    </div>

</section>