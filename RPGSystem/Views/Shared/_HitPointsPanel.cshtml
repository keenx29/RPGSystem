@using RPGSystem.Models.Classes
@model RPGSystem.ViewModels.HitPointsPanelViewModel

<section class="sheet-panel hp-panel">
    @if (Model.Character.ShouldMakeDeathSaves || Model.Character.IsDead)
    {
        <h2 class="sheet-panel-title">Death Saves</h2>

        <partial name="_DeathSavesPanel" model="Model.Character" />

        <div class="sheet-divider"></div>

        <div class="text-muted small">
            Hit Points: @Model.Character.CurrentHP / @Model.Character.MaxHP
        </div>
    }
    else
    {
        <h2 class="sheet-panel-title">Hit Points</h2>

        <div class="hp-current">
            <span>@Model.Character.CurrentHP</span>
            <span class="text-muted">/</span>
            <span>@Model.Character.MaxHP</span>
        </div>
        
        <form asp-controller="Character" asp-action="ModifyHP" method="post" class="mt-3">
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-sm btn-outline-danger"
                        name="mode"
                        value="damage">
                    Damage
                </button>

                <input type="number"
                       name="amount"
                       value="1"
                       min="1"
                       class="form-control form-control-sm text-center"
                       style="width: 80px;" />

                <button class="btn btn-sm btn-outline-success hp-heal-button"
                        name="mode"
                        value="heal">
                    Heal
                </button>
            </div>
        </form>
    }

    <div class="sheet-divider"></div>

    <div class="hp-rest-controls">
        <div class="hit-dice-control">
            <div class="hit-dice-summary">
                <strong>Hit Dice</strong>

                <span class="text-muted small">
                    @Model.Character.HitDiceRemaining / @(Model.Character.MaxHitDice)d@(Model.HitDie)
                </span>
            </div>

            <form asp-action="RollHitDie" method="post" class="m-0">
                <button class="btn btn-sm btn-outline-light"
                        disabled="@(!Model.Character.CanSpendHitDie)">
                    Roll
                </button>
            </form>
        </div>

        <div class="rest-actions">
            <span class="rest-label">Rest:</span>

            <form asp-controller="Character" asp-action="ShortRest" method="post" class="m-0">
                <button class="btn btn-sm btn-outline-warning"
                        disabled="@Model.Character.IsDead">
                    Short
                </button>
            </form>

            <form asp-controller="Character" asp-action="LongRest" method="post" class="m-0">
                <button class="btn btn-sm btn-outline-success rest-long-button"
                        disabled="@Model.Character.IsDead">
                    Long
                </button>
            </form>
        </div>
    </div>
</section>