@model RPGSystem.ViewModels.HitPointsPanelViewModel

<section class="sheet-panel hp-panel">
    @if (Model.Character.ShouldMakeDeathSaves || Model.Character.IsDead)
    {
        <h2 class="sheet-panel-title">Death Saves</h2>

        <partial name="_DeathSavesPanel" model="Model.Character" />

        <div class="sheet-divider"></div>

        <div class="text-muted small">
            Hit Points: @Model.Character.CurrentHP / @Model.Character.MaxHP
        </div>
    }
    else
    {
        <h2 class="sheet-panel-title">Hit Points</h2>

        <div class="hp-current">
            <span>@Model.Character.CurrentHP</span>
            <span class="text-muted">/</span>
            <span>@Model.Character.MaxHP</span>
        </div>

        <form asp-controller="Character" asp-action="ModifyHP" method="post" class="mt-3">
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-sm btn-danger"
                        name="mode"
                        value="damage">
                    Damage
                </button>

                <input type="number"
                       name="amount"
                       value="1"
                       min="1"
                       class="form-control form-control-sm text-center"
                       style="width: 80px;" />

                <button class="btn btn-sm btn-success"
                        name="mode"
                        value="heal">
                    Heal
                </button>
            </div>
        </form>
    }

    <div class="sheet-divider"></div>

    <div class="d-flex justify-content-between align-items-center">
        <div>
            <strong>Hit Dice</strong>
            <div class="text-muted small">
                @Model.Character.HitDiceRemaining / @(Model.Character.MaxHitDice)d@(Model.HitDie)
            </div>
        </div>

        <div class="d-flex gap-2">
            <form asp-controller="Character" asp-action="ShortRest" method="post" class="d-flex gap-2">
                <input type="number"
                       name="hitDiceCount"
                       value="0"
                       min="0"
                       max="@Model.Character.HitDiceRemaining"
                       class="form-control form-control-sm text-center"
                       style="width: 70px;" />

                <button class="btn btn-sm btn-warning">
                    Short
                </button>
            </form>

            <form asp-controller="Character" asp-action="LongRest" method="post">
                <button class="btn btn-sm btn-success">
                    Long
                </button>
            </form>
        </div>
    </div>
</section>