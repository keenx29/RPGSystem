@using RPGSystem.Helpers
@using RPGSystem.Models.Items
@inject RPGSystem.Services.DiceService DiceService
@model RPGSystem.Models.Characters.Character

<section class="sheet-panel equipped-panel">

    <h2 class="sheet-panel-title">Equipped</h2>

    <h3 class="sheet-subtitle">Weapons</h3>

    @if (Model.EquippedWeapons.Any())
    {
        foreach (var weapon in Model.EquippedWeapons)
        {
            var attackBonus = Model.GetAttackBonus(weapon);
            var damageBonus = Model.GetDamageBonus(weapon);
            var damageType = string.IsNullOrWhiteSpace(weapon.DamageType)
            ? "Damage"
            : char.ToUpperInvariant(weapon.DamageType[0]) +
            weapon.DamageType[1..].ToLowerInvariant();

            var damageDice = DiceService.GetBaseDiceNotation(weapon.DamageDice);
            var weaponDamageBonus = DiceService.GetDiceModifier(weapon.DamageDice);
            var damageAbility = Model.GetAttackAbility(weapon);

            var damageParts = new List<string>
        {
        $"{damageType} Damage {damageDice}"
        };

            if (weaponDamageBonus != 0)
            {
                damageParts.Add(
                $"{ModifierFormatter.FormatWithSpace(weaponDamageBonus)} Weapon Bonus");
            }

            if (damageBonus != 0)
            {
                damageParts.Add(
                $"{ModifierFormatter.FormatWithSpace(damageBonus)} {damageAbility.Name}");
            }

            var damageText = string.Join(" ", damageParts);

            <div class="equipment-row">
                <div>
                    <strong>@weapon.Name</strong>
                    @if (Model.IsProficientWithWeapon(weapon))
                    {
                        <span class="badge bg-secondary">Proficient</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">Not proficient</span>
                    }
                    
                    <div class="text-muted small">
                        Attack @ModifierFormatter.FormatWithoutSpace(attackBonus)
                        · @damageText
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <form asp-controller="Character" asp-action="RollAttack" method="post" class="m-0">
                        <input type="hidden" name="weaponId" value="@weapon.Id" />
                        <button class="btn btn-sm btn-danger">Attack</button>
                    </form>

                    <form asp-controller="Character" asp-action="UnequipWeapon" method="post" class="m-0">
                        <input type="hidden" name="weaponId" value="@weapon.Id" />
                        <button class="btn btn-sm btn-outline-secondary">Unequip</button>
                    </form>
                </div>
            </div>
        }
    }
    else
    {
        <p class="text-muted mb-0">No weapons equipped.</p>
    }

    <h3 class="sheet-subtitle mt-3">Armor</h3>

    <div class="equipment-row">
        <div>
            <strong>@(Model.EquippedArmor?.Name ?? "Unarmored")</strong>
            @if (Model.EquippedArmor != null)
            {
                if (Model.IsProficientWithArmor(Model.EquippedArmor))
                {
                    <span class="badge bg-secondary">Proficient</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark">Not proficient</span>
                }

                <div class="text-muted small">@Model.EquippedArmor.ArmorType armor</div>
            }
        </div>
        @if (Model.EquippedArmor != null)
        {
            <div>
                <form asp-controller="Character" asp-action="UnequipArmor" method="post" class="m-0">
                    <input type="hidden" name="armorId" value="@Model.EquippedArmor?.Id" />
                    <button class="btn btn-sm btn-outline-secondary">Unequip</button>
                </form>
            </div>
        }
        
    </div>

    <h3 class="sheet-subtitle mt-3">Shield</h3>

    <div class="equipment-row">
        <div>
            <strong>@(Model.EquippedShield?.Name ?? "No shield equipped")</strong>
            @if (Model.EquippedShield != null)
            {
                if (Model.IsProficientWithShield())
                {
                    <span class="badge bg-secondary">Proficient</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark">Not proficient</span>
                }
                <div class="text-muted small">+@Model.EquippedShield.BaseArmorClass AC</div>
            }
        </div>
        @if (Model.EquippedShield != null)
        {
            <div>
                <form asp-controller="Character" asp-action="UnequipShield" method="post" class="m-0">
                    <input type="hidden" name="shieldId" value="@Model.EquippedShield?.Id" />
                    <button class="btn btn-sm btn-outline-secondary">Unequip</button>
                </form>
            </div>
        }
        
    </div>

</section>