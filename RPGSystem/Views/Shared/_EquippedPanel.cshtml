@using RPGSystem.Helpers
@using RPGSystem.Models.Characters
@using RPGSystem.Models.Items
@inject RPGSystem.Services.DiceService DiceService
@model RPGSystem.Models.Characters.Character
@{
    string GetArmorDetails(Armor armor)
    {
        var dexterityModifier =
            Model.GetAbility(AbilityType.Dexterity).Modifier;

        var shieldBonus =
            Model.EquippedShield?.BaseArmorClass ?? 0;

        var shieldText = shieldBonus > 0
            ? $" + {shieldBonus} Shield"
            : "";

        return armor.ArmorType switch
        {
            ArmorType.Light =>
                $"AC {Model.GetArmorClass()} = {armor.BaseArmorClass} Base {ModifierFormatter.FormatWithSpace(dexterityModifier)} Dexterity{shieldText}",

            ArmorType.Medium =>
                $"AC {Model.GetArmorClass()} = {armor.BaseArmorClass} Base {ModifierFormatter.FormatWithSpace(Math.Min(dexterityModifier, 2))} Dexterity (max +2){shieldText}",

            ArmorType.Heavy =>
                $"AC {Model.GetArmorClass()} = {armor.BaseArmorClass} Base{shieldText}",

            _ =>
                $"+{armor.BaseArmorClass} AC shield bonus"
        };
    }
}

<section class="sheet-panel equipped-panel">

    <h2 class="sheet-panel-title">Equipped</h2>

    <h3 class="sheet-subtitle">Weapons</h3>

    @if (Model.EquippedWeapons.Any())
    {
        foreach (var weapon in Model.EquippedWeapons)
        {
            var attackBonus = Model.GetAttackBonus(weapon);
            var damageBonus = Model.GetDamageBonus(weapon);
            var damageType = string.IsNullOrWhiteSpace(weapon.DamageType)
            ? "Damage"
            : char.ToUpperInvariant(weapon.DamageType[0]) +
            weapon.DamageType[1..].ToLowerInvariant();

            var damageDice = DiceService.GetBaseDiceNotation(weapon.DamageDice);
            var weaponDamageBonus = DiceService.GetDiceModifier(weapon.DamageDice);
            var damageAbility = Model.GetAttackAbility(weapon);
            var isWeaponProficient = Model.IsProficientWithWeapon(weapon);
            var damageParts = new List<string>
            {
                $"{damageType} Damage {damageDice}"
            };

            if (weaponDamageBonus != 0)
            {
                damageParts.Add(
                $"{ModifierFormatter.FormatWithSpace(weaponDamageBonus)} Weapon Bonus");
            }

            if (damageBonus != 0)
            {
                damageParts.Add(
                $"{ModifierFormatter.FormatWithSpace(damageBonus)} {damageAbility.Name}");
            }

            var damageText = string.Join(" ", damageParts);

            <div class="equipment-row">
                <div>
                    <div class="equipment-name-line">
                        <strong>@weapon.Name</strong>

                        <div class="equipment-tags">
                            <span class="equipment-tag @(isWeaponProficient ? "is-proficient" : "is-not-proficient")">
                                @(isWeaponProficient ? "Proficient" : "Not proficient")
                            </span>

                            <span class="equipment-tag">@weapon.ScalingType</span>
                        </div>
                    </div>

                    <div class="equipment-details">
                        Attack @ModifierFormatter.FormatWithoutSpace(attackBonus)
                        · @damageText
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <form asp-controller="Character" asp-action="RollAttack" method="post" class="m-0">
                        <input type="hidden" name="weaponId" value="@weapon.Id" />
                        <button class="btn btn-sm btn-outline-danger">Attack</button>
                    </form>

                    <form asp-controller="Character" asp-action="UnequipWeapon" method="post" class="m-0">
                        <input type="hidden" name="weaponId" value="@weapon.Id" />
                        <button class="btn btn-sm btn-outline-dark">Unequip</button>
                    </form>
                </div>
            </div>
        }
    }
    else
    {
        <p class="text-muted mb-0">No weapons equipped.</p>
    }

    <h3 class="sheet-subtitle mt-3">Armor</h3>

    <div class="equipment-row">
        <div>
            @if (Model.EquippedArmor != null)
            {
                var armor = Model.EquippedArmor;
                var isArmorProficient =
                Model.IsProficientWithArmor(armor);

                <div class="equipment-name-line">
                    <strong>@armor.Name</strong>

                    <div class="equipment-tags">
                        <span class="equipment-tag @(isArmorProficient ? "is-proficient" : "is-not-proficient")">
                            @(isArmorProficient ? "Proficient" : "Not proficient")
                        </span>

                        <span class="equipment-tag">@armor.ArmorType Armor</span>
                    </div>
                </div>

                <div class="equipment-details">
                    @GetArmorDetails(armor)
                </div>

                @if (!isArmorProficient)
                {
                    <div class="equipment-warning">
                        Disadvantage on Strength/Dexterity attacks, checks and saving throws.
                    </div>
                }
            }
            else
            {
                <strong>Unarmored</strong>
            }
        </div>
        @if (Model.EquippedArmor != null)
        {
            <div>
                <form asp-controller="Character" asp-action="UnequipArmor" method="post" class="m-0">
                    <input type="hidden" name="armorId" value="@Model.EquippedArmor?.Id" />
                    <button class="btn btn-sm btn-outline-dark">Unequip</button>
                </form>
            </div>
        }
        
    </div>

    <h3 class="sheet-subtitle mt-3">Shield</h3>

    <div class="equipment-row">
        <div>
            @if (Model.EquippedShield != null)
            {
                var shield = Model.EquippedShield;
                var isShieldProficient = Model.IsProficientWithShield();

                <div class="equipment-name-line">
                    <strong>@shield.Name</strong>

                    <div class="equipment-tags">
                        <span class="equipment-tag @(isShieldProficient ? "is-proficient" : "is-not-proficient")">
                            @(isShieldProficient ? "Proficient" : "Not proficient")
                        </span>

                        <span class="equipment-tag">Shield</span>
                    </div>
                </div>

                <div class="equipment-details">
                    +@shield.BaseArmorClass AC shield bonus
                </div>
            }
            else
            {
                <strong>No shield equipped</strong>
            }
        </div>
        @if (Model.EquippedShield != null)
        {
            <div>
                <form asp-controller="Character" asp-action="UnequipShield" method="post" class="m-0">
                    <input type="hidden" name="shieldId" value="@Model.EquippedShield?.Id" />
                    <button class="btn btn-sm btn-outline-dark">Unequip</button>
                </form>
            </div>
        }
        
    </div>

</section>