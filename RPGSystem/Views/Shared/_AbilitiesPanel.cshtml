@using RPGSystem.ViewModels
@model RPGSystem.Models.Characters.Character

<section class="sheet-panel abilities-panel">

    <div class="ability-panel-header">
        <h2 class="sheet-panel-title">Abilities</h2>

        @if (Model.PendingAbilityScoreImprovementPoints > 0)
        {
            <div class="asi-status">
                <span>Ability Score Improvement</span>
                <strong>
                    @Model.PendingAbilityScoreImprovementPoints point@(Model.PendingAbilityScoreImprovementPoints == 1 ? "" : "s")
                </strong>
            </div>
        }
    </div>

    <div class="ability-card-grid">
        @foreach (var ability in Model.Abilities)
        {
            <partial name="_AbilityCard"
                     model="new AbilityCardViewModel
                     {
                         Ability = ability,
                         CanIncreaseScore =
                            Model.PendingAbilityScoreImprovementPoints > 0 &&
                            ability.Score < 20
                     }" />
        }
    </div>

</section>