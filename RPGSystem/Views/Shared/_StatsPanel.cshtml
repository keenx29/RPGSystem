@using RPGSystem.Helpers
@model RPGSystem.Models.Characters.Character

<section class="sheet-panel stats-panel">

    <h2 class="sheet-panel-title">Stats</h2>

    <div class="stat-list">
        <div class="stat-row">
            <span>Armor Class</span>
            <strong>@Model.GetArmorClass()</strong>
        </div>

        <div class="stat-row">
            <span>Speed</span>
            <strong>@Model.TotalMovementSpeed ft.</strong>
        </div>

        <div class="stat-row">
            <span>Initiative</span>
            <strong>@ModifierFormatter.FormatWithoutSpace(Model.GetInitiative())</strong>
        </div>
    </div>

</section>