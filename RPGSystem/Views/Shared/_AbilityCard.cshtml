@using RPGSystem.Helpers
@model RPGSystem.ViewModels.AbilityCardViewModel

@{
    var ability = Model.Ability;

    var nextSavingThrowProficiencyValue =
        ability.IsSavingThrowProficient ? "false" : "true";
}

<article class="ability-card">

    <h3>@ability.Name</h3>

    <div class="ability-score-row">
        <span class="ability-score">@ability.Score</span>

        @if (Model.CanIncreaseScore)
        {
            <form asp-action="IncreaseAbilityScore" method="post">
                <input type="hidden"
                       name="abilityType"
                       value="@ability.Type" />

                <button type="submit"
                        class="ability-score-increase"
                        title="Increase @ability.Name by 1">
                    +1
                </button>
            </form>
        }
    </div>

    <p class="ability-modifier">
        Modifier
        <strong>@ModifierFormatter.FormatWithoutSpace(ability.Modifier)</strong>
    </p>

    <div class="ability-actions">

        <form asp-action="RollAbility" method="post" class="m-0">
            <input type="hidden"
                   name="abilityType"
                   value="@ability.Type" />

            <button class="btn btn-outline-warning btn-sm">
                Check
            </button>
        </form>

        <form asp-action="RollSavingThrow" method="post" class="m-0">
            <input type="hidden"
                   name="abilityType"
                   value="@ability.Type" />

            <button class="btn btn-sm @(ability.IsSavingThrowProficient ? "btn-outline-danger" : "btn-outline-dark")">
                Save
            </button>
        </form>

        <form asp-action="SetSavingThrowProficiency" method="post" class="m-0">
            <input type="hidden"
                   name="abilityType"
                   value="@ability.Type" />

            <input type="hidden"
                   name="isProficient"
                   value="@nextSavingThrowProficiencyValue" />

            <button type="submit"
                    class="skill-toggle save-toggle @(ability.IsSavingThrowProficient ? "selected" : "")"
                    title="Saving throw proficiency">
                Prof
            </button>
        </form>

    </div>

</article>