@using RPGSystem.Helpers
@using RPGSystem.Models.Characters
@model Ability

<div class="card p-3 m-2 text-center" style="width: 200px;">

    <h4>@Model.Name</h4>

    <h2>@Model.Score</h2>

    <p>
        Modifier:
        <span>@ModifierFormatter.FormatWithoutSpace(Model.Modifier)</span>
    </p>
    <div class="d-flex justify-content-center gap-2">

        <form asp-action="RollAbility" method="post">

            <input type="hidden"
                    name="abilityType"
                    value="@Model.Type" />

            <button class="btn btn-dark btn-sm">
                Check
            </button>

        </form>

        <form asp-action="RollSavingThrow" method="post">

            <input type="hidden"
                    name="abilityType"
                    value="@Model.Type" />

            <button class="btn btn-sm @(Model.IsSavingThrowProficient ? "btn-outline-danger" : "btn-outline-dark")">
                Save
            </button>

        </form>
        <form asp-action="SetSavingThrowProficiency" method="post" class="d-inline">
            <input type="hidden" name="abilityType" value="@Model.Type" />

            <label class="d-inline-flex align-items-center gap-1 small">
                <input type="checkbox"
                       name="isProficient"
                       value="true"
                       checked="@Model.IsSavingThrowProficient"
                       onchange="this.form.submit()" />
                <input type="hidden" name="isProficient" value="false" />
                Prof
            </label>
        </form>
    </div>
</div>