@using RPGSystem.Helpers
@using RPGSystem.Models.Characters
@model Ability
@{
    var nextSavingThrowProficiencyValue = Model.IsSavingThrowProficient ? "false" : "true";
}

<div class="card p-3 m-2 text-center" style="width: 200px;">

    <h4>@Model.Name</h4>

    <h2>@Model.Score</h2>

    <p>
        Modifier:
        <span>@ModifierFormatter.FormatWithoutSpace(Model.Modifier)</span>
    </p>
    <div class="ability-actions">

        <form asp-action="RollAbility" method="post" class="m-0">

            <input type="hidden"
                    name="abilityType"
                    value="@Model.Type" />

            <button class="btn btn-dark btn-sm">
                Check
            </button>

        </form>

        <form asp-action="RollSavingThrow" method="post" class="m-0">

            <input type="hidden"
                    name="abilityType"
                    value="@Model.Type" />

            <button class="btn btn-sm @(Model.IsSavingThrowProficient ? "btn-outline-danger" : "btn-outline-dark")">
                Save
            </button>

        </form>
        <form asp-action="SetSavingThrowProficiency" method="post" class="m-0">
            <input type="hidden" name="abilityType" value="@Model.Type" />
            <input type="hidden" name="isProficient" value="@nextSavingThrowProficiencyValue" />

            <button type="submit"
                    class="skill-toggle save-toggle @(Model.IsSavingThrowProficient ? "selected" : "")"
                    title="Saving throw proficiency">
                Prof
            </button>
        </form>
    </div>
</div>