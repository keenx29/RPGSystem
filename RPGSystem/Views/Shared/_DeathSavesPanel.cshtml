@model RPGSystem.Models.Characters.Character

<div class="death-saves-panel">
    <div class="death-save-row">
        <span>Successes</span>
        <div>
            @for (var i = 1; i <= 3; i++)
            {
                <span class="death-save-box @(i <= Model.DeathSaveSuccesses ? "filled" : "")">
                    @(i <= Model.DeathSaveSuccesses ? "x" : "")
                </span>
            }
        </div>
    </div>

    <div class="death-save-row">
        <span>Failures</span>
        <div>
            @for (var i = 1; i <= 3; i++)
            {
                <span class="death-save-box @(i <= Model.DeathSaveFailures ? "filled failure" : "")">
                    @(i <= Model.DeathSaveFailures ? "x" : "")
                </span>
            }
        </div>
    </div>

    @if (Model.IsStable)
    {
        <div class="text-success small">Stable</div>
    }

    @if (Model.IsDead)
    {
        <div class="text-danger small">Dead</div>
    }

    <div class="d-flex gap-2">
        <form asp-action="Stabilize" method="post" class="m-0">
            <button class="btn btn-sm btn-outline-secondary"
                    disabled="@(Model.CurrentHP > 0 || Model.IsStable || Model.IsDead)">
                Stabilize
            </button>
        </form>

        <form asp-action="RollDeathSave" method="post" class="m-0">
            <button class="btn btn-sm btn-danger"
                    disabled="@(!Model.ShouldMakeDeathSaves)">
                Roll
            </button>
        </form>
    </div>
</div>